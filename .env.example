# Environment variables for Tether.
#
# Copy to `.env` and fill in, or export these in your shell.
# Every file is optional: with no key set, Tether runs fully offline on the
# MockProvider (see `tether.llm.factory`) so tests, demos and CI cost nothing.

# --- Option 1: DeepSeek preset (uses https://api.deepseek.com/v1) ---
DEEPSEEK_API_KEY=

# --- Option 2: any OpenAI-compatible endpoint ---
TETHER_LLM_API_KEY=
TETHER_LLM_BASE_URL=https://api.deepseek.com/v1

# Model id shared by both options (default: deepseek-chat).
# The e2e benchmark in the README was run with deepseek-v4-flash.
TETHER_LLM_MODEL=deepseek-chat
